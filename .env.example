# =============================================================================
# AttackRuleMap Automation — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values. Do not commit .env to version control.
# Required variables depend on your setup (Splunk-only vs VM/Proxmox execution).
# =============================================================================

# --- Repository Paths (optional; defaults use data/repos under project root) ---
# Base directory for cloned repos (Sigma, ESCU, Atomic Red Team)
# REPOS_BASE_PATH=
# Sigma rules repo path
# SIGMA_REPO_PATH=
# ESCU / Splunk Security Content repo path
# ESCU_REPO_PATH=
# Sigma rules subdirectory (e.g. rules/)
# SIGMA_RULES_PATH=
# ESCU detections subdirectory (e.g. detections/)
# ESCU_RULES_PATH=
# Atomic Red Team repo path
# ATOMIC_RED_TEAM_REPO=
# Atomic tests directory (e.g. atomics/)
# ATOMIC_TESTS_PATH=
# Platform (e.g. linux , default = windows)
# PLATFORM=linux


# --- Splunk Connection ---
# Splunk host (hostname or IP)
SPLUNK_HOST=localhost
# Splunk management port (default 8089)
SPLUNK_PORT=8089
# Protocol: https or http
SPLUNK_SCHEME=https
# Verify SSL certificate (true/false, 1/0). Set false for self-signed in lab.
SPLUNK_VERIFY_CERT=false
# Splunk username (for basic auth)
SPLUNK_USERNAME=admin
# Splunk password (required if SPLUNK_TOKEN not set)
SPLUNK_PASSWORD=
# Splunk token (optional; if set, token-based auth is used instead of password)
# SPLUNK_TOKEN=
# Index to search for detection events (e.g. main, wineventlog)
SPLUNK_SEARCH_INDEX=main

# --- Automation Timing (Splunk indexing & search) ---
# Seconds to wait for Splunk indexing after test execution (default 900)
SPLUNK_INDEX_WAIT_SECONDS=900
# Time padding (seconds) around execution window when querying Splunk (default 300)
SPLUNK_TIME_PAD_SECONDS=300
# Post-test wait (seconds) before powering off VM to allow Universal Forwarder to send events
POST_EXEC_FORWARD_WAIT_SECONDS=30

# --- Technique Selection ---
# Comma-separated MITRE ATT&CK technique IDs (e.g. T1059.001,T1087.001,T1003.001)
ATTACK_TIDS=T1059.001,T1087.001,T1003.001

# --- VM / Execution Target (optional; for running atomics on a remote Windows VM) ---
# VM hostname or IP
# VM_HOST=
# VM_HOSTNAME=  (defaults to VM_HOST if not set)
# VM SSH/login username
# VM_USERNAME=
# VM password
# VM_PASSWORD=
# Safe directory on VM for Atomic Red Team (e.g. C:\AtomicRedTeam)
# VM_SAFE_DIR=
# VM SSH port (default 22, e.g. 2222 for VirtualBox NAT)
# VM_SSH_PORT=22
# Path to SSH private key (optional; if not set, password auth is used)
# VM_SSH_KEY_PATH=
# Linux only: real NIC name of the VM (e.g. enp0s3). Overrides Atomic tests'
# default "interface" arg (often eth0/ens33) so packet-capture tests work.
# VM_INTERFACE=

# --- Atomic Red Team Paths (Windows VM; optional) ---
# Path to Invoke-AtomicRedTeam.psd1 on the VM
# ATOMIC_MODULE_PATH=C:\AtomicRedTeam\invoke-atomicredteam\Invoke-AtomicRedTeam.psd1
# Path to atomics folder on the VM
# ATOMIC_ATOMICS_PATH=C:\AtomicRedTeam\atomics

# --- Proxmox (optional; for snapshot-based lab VMs) ---
# Set to false if not using Proxmox (e.g. VirtualBox, VMware)
# USE_PROXMOX=true
# Proxmox host
# PROXMOX_HOST=
# Proxmox user (default root)
# PROXMOX_USER=root
# Proxmox password
# PROXMOX_PASSWORD=
# Optional: path to SSH private key instead of password
# PROXMOX_KEY_PATH=
# Proxmox SSH port (PROXMOX_SSH_PORT or PROXMOX_PORT, default 22)
# PROXMOX_PORT=22
# Target VM ID (e.g. 100)
# TARGET_VM_ID=
# Snapshot name to revert to before each run
# TARGET_SNAPSHOT=

# --- VM Command Timeout ---
# Max seconds for a single command execution on the VM (default 600)
VM_COMMAND_TIMEOUT_SECONDS=600

# --- Per-Test Verification (optional; stricter validation) ---
# Enable per-test Splunk verification (true/false, 1/0)
PER_TEST_VERIFICATION=false
# Timeout (seconds) for per-test verification poll
PER_TEST_VERIFY_TIMEOUT_SECONDS=180
# Poll interval (seconds) when checking for detection
PER_TEST_VERIFY_POLL_INTERVAL_SECONDS=15

# --- Strict Ingestion Wait (optional; keep VM up until events seen or timeout) ---
# Wait until events are observed in Splunk or max wait (true/false)
PER_TEST_STRICT_INGESTION_WAIT=false
# Max seconds to wait for ingestion
PER_TEST_STRICT_MAX_WAIT_SECONDS=300
# Poll interval (seconds) when checking for ingestion
PER_TEST_INGESTION_POLL_INTERVAL_SECONDS=10
# Abort remaining tests and leave VM running on ingestion timeout (true/false)
PER_TEST_ABORT_ON_INGESTION_TIMEOUT=false
